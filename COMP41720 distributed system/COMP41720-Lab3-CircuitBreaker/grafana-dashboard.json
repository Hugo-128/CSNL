{
  "dashboard": {
    "title": "Lab 3 - LLM Gateway Resilience",
    "uid": "lab3-llm-gateway",
    "timezone": "browser",
    "refresh": "5s",
    "panels": [
      {
        "title": "Request Rate (req/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(llm_generate_requests_total[1m]))",
            "legendFormat": "requests/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
          "overrides": []
        }
      },
      {
        "title": "Error Rate (err/s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(llm_errors_total[1m]))",
            "legendFormat": "errors/s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
          "overrides": []
        }
      },
      {
        "title": "P99 Latency (s)",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum(rate(llm_generate_duration_seconds_bucket[1m])) by (le))",
            "legendFormat": "p99",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {"unit": "s", "color": {"mode": "palette-classic"}},
          "overrides": []
        }
      },
      {
        "title": "Circuit State",
        "type": "stat",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "llm_circuit_breaker_state{state=\"open\"}",
            "legendFormat": "open",
            "refId": "A"
          },
          {
            "expr": "llm_circuit_breaker_state{state=\"half-open\"}",
            "legendFormat": "half-open",
            "refId": "B"
          },
          {
            "expr": "llm_circuit_breaker_state{state=\"closed\"}",
            "legendFormat": "closed",
            "refId": "C"
          }
        ],
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"],
            "fields": "/^open$|^half-open$|^closed$/"
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 0.5},
                {"color": "red", "value": 1}
              ]
            }
          },
          "overrides": [
            {"matcher": {"id": "byName", "options": "open"}, "properties": [{"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "half-open"}, "properties": [{"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}}]},
            {"matcher": {"id": "byName", "options": "closed"}, "properties": [{"id": "color", "value": {"fixedColor": "green", "mode": "fixed"}}]}
          ]
        }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}
